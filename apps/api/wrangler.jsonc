{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rms-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-12-30",
  // nodejs_compat gives us the few Node shims Better Auth needs on the edge.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    // Local `wrangler dev` default — the Vite dev server origin. CI's deploy to
    // production overrides this at deploy time with
    // `wrangler deploy --var WEB_ORIGIN:<pages-url>` (see .github/workflows/deploy.yml
    // and docs/DEPLOYMENT.md) rather than hardcoding the production URL here, since
    // this file also governs local dev.
    "WEB_ORIGIN": "http://localhost:5173"
  }
  // Secrets (DATABASE_URL, BETTER_AUTH_SECRET, RESEND_API_KEY, R2_*) are set with
  // `wrangler secret put` — never listed here.
  //
  // R2 bucket for lease documents and receipts; uncomment once the bucket exists:
  // "r2_buckets": [{ "binding": "DOCS", "bucket_name": "rms-documents" }]
}
