{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:live": "docker compose -f ../../docker-compose.yml exec -T api sh -c 'cd /workspace/apps/api && DATABASE_URL=postgres://rms:rms_dev_password@db.localtest.me:5432/rms NEON_LOCAL_FETCH_ENDPOINT=http://db.localtest.me:4444/sql pnpm exec vitest run'"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@rms/contract": "workspace:*",
    "better-auth": "^1.7.17",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "drizzle-kit": "^0.31.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  }
}
