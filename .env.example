# Copy to `.env` (gitignored) for the local Docker stack. All optional.
#
# Mailtrap sandbox — captures every outgoing email instead of delivering it, so a
# mistyped tenant address in development can never reach a real person. Without
# these, sends are logged and discarded and password reset cannot be tested, since
# its token exists only inside the email.
#
# IMPORTANT: this is the HTTP API token from Mailtrap's "API Tokens" page, NOT the
# SMTP username/password. Cloudflare Workers cannot open TCP sockets, so SMTP is
# unusable here.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

# Overrides the dev-only default in docker-compose.yml. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
